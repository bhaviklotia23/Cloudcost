# ---- Core ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://cloudcost:cloudcost@localhost:5432/cloudcost
REDIS_URL=redis://localhost:6379
# Public URL of the Next.js app (used in email links and CORS)
WEB_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECURE=false

# ---- Email (Mailpit locally; SES/Resend SMTP in production) ----
SMTP_URL=smtp://localhost:1025
MAIL_FROM="CloudCost <digest@cloudcost.local>"

# ---- AWS ----
# The IAM principal (role/user ARN) CloudCost runs as. Customers trust THIS principal
# in their read-only role, scoped by a per-account ExternalId.
CLOUDCOST_PRINCIPAL_ARN=arn:aws:iam::111122223333:role/cloudcost-app
# Optional: public S3 URL of infra/iam/cloudcost-readonly-role.yaml to enable the
# one-click "Launch CloudFormation stack" button.
CFN_TEMPLATE_URL=
# Allow orgs to connect a synthetic "demo" account (no AWS needed)
ENABLE_DEMO_ACCOUNTS=true

# ---- Schedules (UTC cron) ----
SYNC_CRON=0 6 * * *
DIGEST_CRON=0 9 * * 1
