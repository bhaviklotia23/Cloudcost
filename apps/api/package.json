{
  "name": "@cloudcost/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-cost-explorer": "3.1140.0",
    "@aws-sdk/client-sts": "3.1140.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.1",
    "@smithy/types": "4.19.0",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.3",
    "helmet": "8.3.0",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.6",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "aws-sdk-client-mock": "4.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
